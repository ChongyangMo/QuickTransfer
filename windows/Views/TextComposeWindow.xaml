<Window x:Class="QuickTransfer.Views.TextComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字" Width="480" Height="340" MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="OnKeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
      <ComboBox Style="{StaticResource DeviceSelector}" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Alias" AutomationProperties.Name="接收设备" />
    </Border>
    <TextBox x:Name="Composer" Grid.Row="1" Style="{StaticResource Composer}" Background="{DynamicResource PageBrush}"
             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="14" AutomationProperties.Name="待发送文字" />
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Style="{StaticResource FlatSendButton}" Content="{Binding SendLabel}" Command="{Binding SendCommand}" AutomationProperties.Name="发送文字" />
        <Button DockPanel.Dock="Left" Style="{StaticResource FlatSendButton}" Content="粘贴" Click="Paste" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
