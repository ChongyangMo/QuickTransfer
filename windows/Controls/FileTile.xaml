<UserControl x:Class="QuickTransfer.Controls.FileTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Tile" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <UserControl.Resources>
    <DataTemplate x:Key="GalleryFileContent">
      <Grid ClipToBounds="True">
        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVisibility}}" />
        <Border Background="{DynamicResource PageBrush}">
          <Border.Style>
            <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <Grid Margin="0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.ColumnSpan="2" Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" />
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PendingFileContent">
      <Grid Margin="10,0,4,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Width="36" Height="36" VerticalAlignment="Center" Background="{DynamicResource PageBrush}">
          <Grid.Clip><RectangleGeometry Rect="0,0,36,36" RadiusX="6" RadiusY="6" /></Grid.Clip>
          <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                     Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVisibility}}" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid ClipToBounds="True" SizeChanged="UpdateClip">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid.Style>
      <Style TargetType="Grid">
        <Style.Triggers>
          <DataTrigger Binding="{Binding CanRemove, ElementName=Tile}" Value="True"><Setter Property="Background" Value="{DynamicResource CardBrush}" /></DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Button Content="{Binding}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
            Click="OpenFile" PreviewMouseLeftButtonDown="BeginDrag" PreviewMouseMove="MoveDrag">
      <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource MediaButton}">
          <Setter Property="ContentTemplate" Value="{StaticResource GalleryFileContent}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CanRemove, ElementName=Tile}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource PendingFileContent}" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
    </Button>
    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
              Click="ToggleSelection" ToolTip="选择" AutomationProperties.Name="选择文件">
      <CheckBox.Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource GallerySelectionCheck}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Tile}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding SelectionEnabled, ElementName=Tile}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding CanRemove, ElementName=Tile}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </CheckBox.Style>
    </CheckBox>
    <Button Grid.Column="1" Style="{StaticResource RemoveMediaButton}" Content="&#xE711;" VerticalAlignment="Center" Margin="0,0,4,0"
            ToolTip="移除" AutomationProperties.Name="移除文件" Visibility="{Binding CanRemove, ElementName=Tile, Converter={StaticResource BoolVisibility}}"
            Command="{Binding RemoveCommand, ElementName=Tile}" CommandParameter="{Binding}" />
  </Grid>
</UserControl>
