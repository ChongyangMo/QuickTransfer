<Window x:Class="QuickTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuickTransfer.Controls"
        xmlns:models="clr-namespace:QuickTransfer.Models"
        Title="快传" Width="560" Height="740" MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterScreen" Icon="Assets/quicktransfer.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True"
        PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" PreviewKeyDown="OnKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Menu Background="Transparent" Foreground="{DynamicResource TextBrush}" Padding="4,2">
        <MenuItem Header="文件">
          <MenuItem Header="选择文件" InputGestureText="Ctrl+O" Click="PickFiles" />
          <MenuItem Header="粘贴" InputGestureText="Ctrl+V" Click="Paste" />
          <Separator />
          <MenuItem Header="退出" Click="Exit" />
        </MenuItem>
        <MenuItem Header="文字" Click="OpenTextEditor" AutomationProperties.Name="文字" />
        <MenuItem Header="显示">
          <MenuItem Header="按时间分组" IsCheckable="True" IsChecked="{Binding GroupGalleryByTime, Mode=TwoWay}"
                    AutomationProperties.Name="按时间分组" />
        </MenuItem>
        <MenuItem Header="设备">
          <MenuItem Header="刷新设备" Command="{Binding RefreshCommand}" />
          <MenuItem Header="添加设备" Click="AddPeer" />
        </MenuItem>
        <MenuItem Header="设置" Click="OpenSettings" />
      </Menu>
    </Border>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Style="{StaticResource FlatSendButton}" Content="{Binding SendLabel}" Command="{Binding SendCommand}" AutomationProperties.Name="发送" Margin="14,0,0,0" />
        <Button DockPanel.Dock="Right" Style="{StaticResource FlatSendButton}" Content="{Binding SelectionLabel}" Click="ToggleGallerySelection" AutomationProperties.Name="{Binding SelectionLabel}" />
        <ComboBox Style="{StaticResource DeviceSelector}" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                  DisplayMemberPath="Alias" AutomationProperties.Name="在线设备" />
      </DockPanel>
    </Border>
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8"
            Visibility="{Binding HasActiveTransfers, Converter={StaticResource BoolVisibility}}">
      <ItemsControl ItemsSource="{Binding ActiveTransfers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,2" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10"
            Visibility="{Binding HasAttachments, Converter={StaticResource BoolVisibility}}">
      <ListBox Style="{StaticResource TransferList}" ItemContainerStyle="{StaticResource RecordItem}" ItemsSource="{Binding Attachments}"
               Height="120" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="待发送文件">
        <ListBox.ItemsPanel><ItemsPanelTemplate><controls:MasonryPanel Compact="True" TargetWidth="120" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate><controls:FileTile CanRemove="True" RemoveCommand="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Grid.Row="4">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,4"
              Visibility="{Binding IsSelecting, Converter={StaticResource BoolVisibility}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource FlatSendButton}" Content="复制" Click="CopyGallerySelection" IsEnabled="{Binding HasGallerySelection}" AutomationProperties.Name="复制所选文件" />
            <Button Style="{StaticResource FlatSendButton}" Content="添加" Click="StageGallerySelection" IsEnabled="{Binding HasGallerySelection}" ToolTip="添加到待发送" AutomationProperties.Name="添加所选文件到待发送" />
          </StackPanel>
          <Button DockPanel.Dock="Left" Style="{StaticResource FlatSendButton}" Content="{Binding SelectAllLabel}" Click="ToggleAllGallery" AutomationProperties.Name="{Binding SelectAllLabel}" />
          <TextBlock Text="{Binding SelectedGalleryCount, StringFormat=已选 {0} 项}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </DockPanel>
      </Border>
      <ListBox x:Name="GalleryList" Grid.Row="1" Style="{StaticResource TransferList}" ItemContainerStyle="{StaticResource GalleryItem}"
               SelectionMode="Extended" SelectionChanged="GallerySelectionChanged" ItemsSource="{Binding GalleryTimeline}"
               Margin="14,4,14,14" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="图片与文件">
        <ListBox.Resources>
          <DataTemplate DataType="{x:Type models:GalleryHeader}">
            <DockPanel VerticalAlignment="Center">
              <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
              <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
          <DataTemplate DataType="{x:Type models:GalleryItem}">
            <controls:FileTile DataContext="{Binding File}" SelectionEnabled="{Binding DataContext.IsSelecting, RelativeSource={RelativeSource AncestorType=Window}}" />
          </DataTemplate>
        </ListBox.Resources>
        <ListBox.ItemsPanel><ItemsPanelTemplate><controls:MasonryPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
    </Grid>
    <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8"
            Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
    </Border>
  </Grid>
</Window>
